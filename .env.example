# Copy to a private local environment file, or inject these variables into the executor.
AZURE_LOG_TENANT_ID=
AZURE_LOG_CLIENT_ID=
AZURE_LOG_CLIENT_SECRET=
LOG_ANALYTICS_WORKSPACE_ID=
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_LOG_TOPIC_ID=
# Optional multi-topic variable; reference it with topic_ids_env in a connection.
# VOLC_LOG_TOPIC_IDS=["TOPIC_A","TOPIC_B"]
# Plugin connection is disabled in the example until this array is configured.
VOLC_PLUGIN_LOG_TOPIC_IDS=
# Optional temporary security token for Volcengine STS credentials.
VOLC_SESSION_TOKEN=
# Absolute persistent directory, unique to a schedule and notification destination.
CLOUD_LOG_STATE_DIR=
# Feishu: a URL or JSON [{"webhook":"...","secret":"..."}, ...]. Sends to every configured bot.
FEISHU_WEBHOOK=
FEISHU_SECRET=
FEISHU_KEYWORD=
